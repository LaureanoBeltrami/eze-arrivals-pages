# Empty uses the JSON bundled with the Pages artifact: data/arrivals.json
# For the independent data branch, set a public CORS-enabled HTTPS JSON endpoint, for example:
# VITE_ARRIVALS_JSON_URL=https://raw.githubusercontent.com/LaureanoBeltrami/eze-arrivals-pages/data/public/data/arrivals.json
# Do not put credentials, API keys, or the TAMS URL here: VITE_ variables are public browser code.
