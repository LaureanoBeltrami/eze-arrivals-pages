{
  "name": "eze-arrivals-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run src",
    "test:sync": "node --test tests/node/github-pages-tams-sync.test.mjs tests/node/github-actions-workflow.test.mjs",
    "test:all": "npm run test && npm run test:sync"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.7",
    "vitest": "^5.0.0"
  }
}
